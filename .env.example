# ==============================================================================
# SAFARNAMA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase PostgreSQL + PostGIS & Auth
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Coolify website origin (scheme and hostname, without a trailing slash).
SAFARNAMA_ORIGIN=https://travel.example.com
# Space kept free on the Ubuntu disk, in MiB.
MIN_FREE_MIB=5120
# The Docker build enables server storage. Enable this too for local backend development.
# VITE_SERVER_STORAGE=1
# Set for Android builds only. Use the same HTTPS domain as your website.
# VITE_API_URL=https://travel.example.com

# 2. Google Maps JavaScript API (optional live map)
# Get your API key from https://console.cloud.google.com/google/maps-apis/overview
# Enable "Maps JavaScript API" in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=
# Optional Maps JavaScript API key for the Android app's bundled interface.
# Allow https://appassets.androidplatform.net/* as an HTTP referrer.
VITE_ANDROID_GOOGLE_MAPS_API_KEY=

# 3. Cloudflare R2 Object Storage (Videos, Images, and Avatars Dump)
# Enable "Public Access" or connect a custom domain on your R2 bucket in Cloudflare Dashboard
# Format: https://pub-<bucket-id>.r2.dev OR https://media.yourdomain.com
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# 4. Auto-OTA Updates Manifest
VITE_OTA_MANIFEST_URL=https://raw.githubusercontent.com/Vinay-kumar-code/SafarNama/main/ota/manifest.json
