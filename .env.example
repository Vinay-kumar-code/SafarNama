# ==============================================================================
# SAFARNAMA (सफ़रनामा) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase PostgreSQL + PostGIS & Auth
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Mapbox GL JS (Vector Map Clustering & Custom Indian Travel Theme)
# Get your free public token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6ImNsd3l...

# 3. Cloudflare Stream & R2 / Images (Adaptive HLS video & zero-egress media)
VITE_CLOUDFLARE_STREAM_CUSTOMER_CODE=customer-xxxxxxxxxxxx
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://media.safarnama.travel

# 4. Capgo OTA Updates (Instant Android/iOS Over-The-Air releases without Play Store delay)
# Get from https://capgo.app
VITE_CAPGO_APP_ID=com.safarnama.travel
VITE_CAPGO_CHANNEL=production
