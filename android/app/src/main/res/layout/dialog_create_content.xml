<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_pill" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Create Travel Story"
            android:textColor="@color/text_zinc_900"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/btn_close_create"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_zinc_500" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_zinc_200" />

    <!-- Content Type Selector (Tweet, Photo Post, Reel) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_zinc_50"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tab_type_tweet"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tag_pill"
            android:gravity="center"
            android:text="Travel note"
            android:textColor="@color/brand_coral"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tab_type_photo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tag_pill"
            android:gravity="center"
            android:text="Photo story"
            android:textColor="@color/text_zinc_700"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tab_type_reel"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tag_pill"
            android:gravity="center"
            android:text="Reel"
            android:textColor="@color/text_zinc_700"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Author Header Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_create_user_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Avatar"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_create_user_fullname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/text_zinc_900"
                        android:textSize="14sp"
                        tools:text="Aarav Sharma" />

                    <TextView
                        android:id="@+id/tv_create_user_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_coral"
                        android:textSize="11sp"
                        tools:text="Public Travel Journal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tweet / Caption Input -->
            <EditText
                android:id="@+id/et_create_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="What's happening on your journey? Share live updates, trail conditions, or travel thoughts..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:textColor="@color/text_zinc_900"
                android:textColorHint="@color/text_zinc_400"
                android:textSize="14sp" />

            <!-- Photo & Reel specific inputs container -->
            <LinearLayout
                android:id="@+id/layout_media_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_media"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Choose photos"
                    android:backgroundTint="@color/brand_coral"
                    app:cornerRadius="10dp" />
                <TextView android:id="@+id/tv_selected_media" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No media selected" android:textSize="12sp" android:padding="8dp" android:textColor="@color/text_zinc_500" />
                <ImageView android:id="@+id/iv_media_preview" android:layout_width="match_parent" android:layout_height="140dp" android:scaleType="centerCrop" android:contentDescription="Selected media preview" android:visibility="gone" />
                <EditText
                    android:id="@+id/et_create_spot_name"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_tag_pill"
                    android:hint="Spot Name (e.g. Key Gompa, Assi Ghat)"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_zinc_900"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_create_media_url"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tag_pill"
                    android:hint="Media URL (Image or R2 Video MP4)"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_zinc_900"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_create_state"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_pill"
                        android:hint="State (e.g. Himachal Pradesh)"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_zinc_900"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_create_cost"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_pill"
                        android:hint="Daily Budget (₹)"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_zinc_900"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/border_zinc_200" />

            <!-- Attach Destination Picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="Attach Destination (Maps &amp; Search Tag)"
                android:textColor="@color/text_zinc_700"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinner_destinations"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tag_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- Mention Travel Companions (Group Travel) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="Group Travel Companions (Mentions)"
                android:textColor="@color/text_zinc_700"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_create_mentions"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tag_pill"
                android:hint="@tenzin_spitilocal, @karan_banaras (comma separated)"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_zinc_900"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tagged accounts will have this trip displayed under their Mentions tab."
                android:textColor="@color/text_zinc_400"
                android:textSize="11sp" />

            <!-- Publish Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publish_content"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/brand_coral"
                android:fontFamily="sans-serif-bold"
                android:text="Publish to Feed"
                android:textColor="@color/bg_white"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
