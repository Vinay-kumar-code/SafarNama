<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/iv_following_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Avatar"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_profile" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_following_fullname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_zinc_900"
                android:textSize="14sp"
                tools:text="Tenzin Norbu" />

            <ImageView
                android:id="@+id/iv_following_verified"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Verified"
                android:src="@drawable/ic_verified_guide"
                app:tint="@color/verified_blue" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_following_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_zinc_500"
            android:textSize="12sp"
            tools:text="@tenzin_spitilocal" />
    </LinearLayout>

    <!-- Notification Alert Toggle Button (Bell icon) -->
    <LinearLayout
        android:id="@+id/btn_toggle_notification"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_tag_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/iv_bell_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Notification Alert"
            android:src="@drawable/ic_bell_filled"
            app:tint="@color/brand_coral" />

        <TextView
            android:id="@+id/tv_notification_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Alerts On"
            android:textColor="@color/brand_coral"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Following / Unfollow Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_unfollow"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Following"
        android:textColor="@color/text_zinc_700"
        android:textSize="11sp"
        app:cornerRadius="6dp"
        app:strokeColor="@color/border_zinc_300" />

</LinearLayout>
