<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <!-- Sent Message Layout (Right Aligned) -->
    <LinearLayout
        android:id="@+id/layout_sent_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="64dp"
        android:background="@drawable/bg_message_sent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_sent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/bg_white"
            android:textSize="14sp"
            tools:text="Julley Tenzin! Yes, taking the morning HRTC bus from Reckong Peo." />

        <TextView
            android:id="@+id/tv_sent_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="#E0FFFFFF"
            android:textSize="10sp"
            tools:text="10:32 AM" />
    </LinearLayout>

    <!-- Received Message Layout (Left Aligned) -->
    <LinearLayout
        android:id="@+id/layout_received_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bg_message_received"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_received_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_zinc_900"
            android:textSize="14sp"
            tools:text="Julley Aarav! Are you reaching Kaza by Thursday afternoon?" />

        <TextView
            android:id="@+id/tv_received_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_zinc_400"
            android:textSize="10sp"
            tools:text="10:30 AM" />
    </LinearLayout>

</LinearLayout>
