<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="72dp">

            <!-- Profile Top Bar with Username and Settings Gear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tv_top_username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/text_zinc_900"
                    android:textSize="18sp"
                    tools:text="aarav_journeys" />

                <!-- Settings & Following Gear Icon -->
                <ImageView
                    android:id="@+id/btn_profile_settings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings &amp; Following"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_zinc_900" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_zinc_200" />

            <!-- Profile Header Info (Avatar & Stats) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp">

                <!-- Avatar with Ring -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_story_ring" />

                    <ImageView
                        android:id="@+id/iv_profile_avatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:contentDescription="Profile Picture"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_profile" />
                </FrameLayout>

                <!-- Clean Stats (Trips, Posts, Saved - NO Karma, NO Stamps, NO Follower Count) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Trips -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_trips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/text_zinc_900"
                            android:textSize="17sp"
                            tools:text="14" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trips"
                            android:textColor="@color/text_zinc_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Posts & Tweets -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_posts_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/text_zinc_900"
                            android:textSize="17sp"
                            tools:text="28" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Posts"
                            android:textColor="@color/text_zinc_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Saved -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stat_saved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/text_zinc_900"
                            android:textSize="17sp"
                            tools:text="42" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saved"
                            android:textColor="@color/text_zinc_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Name, Role & Bio Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_profile_fullname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_zinc_900"
                    android:textSize="15sp"
                    tools:text="Aarav Sharma" />

                <!-- Role Badge -->
                <TextView
                    android:id="@+id/tv_profile_role_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_tag_pill"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    tools:text="🛡️ Verified Guide • Spiti Valley High Passes" />

                <TextView
                    android:id="@+id/tv_profile_bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_zinc_900"
                    android:textSize="13sp"
                    tools:text="Chasing Himalayan sunsets &amp; South Indian filter coffee ☕ | 18 Indian States explored | Next: Ziro Festival 🏕️" />

                <TextView
                    android:id="@+id/tv_profile_homecity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_zinc_500"
                    android:textSize="12sp"
                    tools:text="📍 Bengaluru, Karnataka • Hindi, English, Kannada" />
            </LinearLayout>

            <!-- Action Buttons: Follow, Message, Edit, Switch Persona -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_follow_profile"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/brand_coral"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Following"
                    android:textColor="@color/bg_white"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_message_profile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Message"
                    android:textColor="@color/text_zinc_900"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/border_zinc_300" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_switch_persona"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Switch Mode"
                    android:textColor="@color/brand_coral"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/brand_coral" />
            </LinearLayout>

            <!-- Profile Segment Tabs (Posts & Tweets, Mentions, Saved) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tab 1: Posts & Tweets -->
                <LinearLayout
                    android:id="@+id/tab_posts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tab_posts_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Posts &amp; Tweets"
                        android:textColor="@color/text_zinc_900"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/indicator_posts"
                        android:layout_width="40dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/brand_coral" />
                </LinearLayout>

                <!-- Tab 2: Mentions (Group Travel) -->
                <LinearLayout
                    android:id="@+id/tab_mentions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tab_mentions_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="👥 Mentions"
                        android:textColor="@color/text_zinc_500"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/indicator_mentions"
                        android:layout_width="40dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Tab 3: Saved Spots -->
                <LinearLayout
                    android:id="@+id/tab_saved"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_tab_saved_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="🔖 Saved"
                        android:textColor="@color/text_zinc_500"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/indicator_saved"
                        android:layout_width="40dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_zinc_200" />

            <!-- Posts & Tweets List / Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_profile_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_feed_tweet" />

            <!-- Mentions Section List (Separately displayed for tagged group travels) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_profile_mentions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_feed_tweet" />

            <!-- Saved Spots Grid (Toggled) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_saved_spots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:listitem="@layout/item_saved_spot" />

            <!-- Empty State for Mentions or Posts -->
            <TextView
                android:id="@+id/tv_profile_empty_state"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="No content found in this section yet."
                android:textColor="@color/text_zinc_400"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
