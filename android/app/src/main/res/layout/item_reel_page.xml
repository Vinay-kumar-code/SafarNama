<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Media3 ExoPlayer View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="zoom"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- Fallback/Preview Thumbnail -->
    <ImageView
        android:id="@+id/iv_reel_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="visible" />

    <!-- Gradient Dark Scrim on Bottom for Text Legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="#80000000" />

    <!-- Double-Tap Heart Animation Overlay (Instagram Style Burst) -->
    <ImageView
        android:id="@+id/iv_reel_double_tap_heart"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:scaleX="0.2"
        android:scaleY="0.2"
        android:src="@drawable/ic_heart_filled"
        app:tint="@color/heart_red" />

    <!-- Right Side Actions Bar (Like, Comment, Share, Save) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Like Button -->
        <ImageView
            android:id="@+id/btn_reel_like"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_heart_outline"
            app:tint="@color/bg_white" />

        <TextView
            android:id="@+id/tv_reel_likes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="4.2k"
            android:textColor="@color/bg_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Comment Button -->
        <ImageView
            android:id="@+id/btn_reel_comment"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_comment"
            app:tint="@color/bg_white" />

        <TextView
            android:id="@+id/tv_reel_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="142"
            android:textColor="@color/bg_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Share Button -->
        <ImageView
            android:id="@+id/btn_reel_share"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            app:tint="@color/bg_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:text="Share"
            android:textColor="@color/bg_white"
            android:textSize="11sp" />

        <!-- Save Button -->
        <ImageView
            android:id="@+id/btn_reel_save"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bookmark_outline"
            app:tint="@color/bg_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Save"
            android:textColor="@color/bg_white"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Bottom Left Creator & Spot Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <!-- Author Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_reel_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />

            <TextView
                android:id="@+id/tv_reel_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@tenzin_spitilocal"
                android:textColor="@color/bg_white"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_reel_verified"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_verified_guide" />

            <TextView
                android:id="@+id/btn_reel_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_pill"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Follow"
                android:textColor="@color/text_zinc_900"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spot & Region Tag -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/brand_gold" />

            <TextView
                android:id="@+id/tv_reel_spot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Kunzum Pass (4,551 m), Himachal Pradesh"
                android:textColor="@color/brand_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Caption -->
        <TextView
            android:id="@+id/tv_reel_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Crossing Kunzum Pass at dawn. Fresh powder snow on the shrine. Always pray at the stupa for safe passage!"
            android:textColor="@color/bg_white"
            android:textSize="13sp" />

        <!-- Ambient Travel Sound Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_reel_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="🎵 Original Audio - Himalayan Wind &amp; Prayer Bells"
                android:textColor="#E0E0E0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
