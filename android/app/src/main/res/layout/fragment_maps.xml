<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Interactive Google Map Fragment Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/map_preview_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Explore India by place" android:textSize="25sp"
            android:textColor="@color/text_zinc_900" android:gravity="center" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Pick a destination to see its guide and open directions in Maps."
            android:gravity="center" android:layout_marginTop="10dp" android:textSize="14sp"
            android:textColor="@color/text_zinc_700" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_browse_map_places"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Browse places" />
    </LinearLayout>

    <!-- Top Map Filter Chips Floating Overlay -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/chip_map_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pill"
                android:text="All Hubs"
                android:textColor="@color/text_zinc_900"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_map_passes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="High Passes"
                android:textColor="@color/text_zinc_700"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_map_heritage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Heritage"
                android:textColor="@color/text_zinc_700"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_map_monasteries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@null"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Monasteries"
                android:textColor="@color/text_zinc_700"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Floating Re-center FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_recenter_india"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/bg_white"
        android:contentDescription="Center India Map"
        android:src="@drawable/ic_location_pin"
        app:elevation="4dp"
        app:fabSize="mini"
        app:tint="@color/brand_coral" />

    <!-- Bottom Destination Preview Card (Appears on marker click) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_destination_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="16dp"
        android:visibility="visible"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_white"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_map_preview_thumb"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_foreground" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_map_preview_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Spiti Valley Hub"
                        android:textColor="@color/text_zinc_900"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_map_preview_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Himachal Pradesh • 3,800m"
                        android:textColor="@color/text_zinc_500"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_map_preview_budget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_inr"
                            android:text="₹2,200 / day"
                            android:textColor="#B45309"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_map_preview_permits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_pill"
                            android:text="ILP for Foreigners"
                            android:textColor="@color/text_zinc_700"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_explore_hub"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/brand_coral"
                android:text="Explore Destination &amp; Guides"
                android:textColor="@color/bg_white"
                android:textSize="13sp"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
