<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_card_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_guide_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_guide_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Tenzin Norbu"
            android:textColor="@color/text_zinc_900"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_verified_guide" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_guide_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Spiti Valley"
        android:textColor="@color/text_zinc_500"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_guide_credibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_badge_inr"
        android:text="★ 980 pts"
        android:textColor="#B45309"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
