<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.safarnama.travel.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_search"
        android:name="com.safarnama.travel.ui.search.SearchFragment"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/nav_reels"
        android:name="com.safarnama.travel.ui.reels.ReelsFragment"
        android:label="@string/title_reels"
        tools:layout="@layout/fragment_reels" />

    <fragment
        android:id="@+id/nav_maps"
        android:name="com.safarnama.travel.ui.maps.MapsFragment"
        android:label="@string/title_maps"
        tools:layout="@layout/fragment_maps" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.safarnama.travel.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
